									const strong = document.createElement('strong');
									strong.classList.add('me-auto');
									strong.textContent = 'Did You Know?';
									//strong.textContent = title;
									
									const button = document.createElement('button');
									button.type = 'button';
									button.classList.add('btn-close');
									button.setAttribute('data-bs-dismiss', 'toast');
									button.setAttribute('aria-label', 'Close');
									
									toastHeader.appendChild(image); toastHeader.appendChild(strong); toastHeader.appendChild(button);
									
									const toastBody = document.createElement('div');
									toastBody.classList.add('toast-body');

									const strong2 = document.createElement('strong');
									strong2.classList.add('me-auto');
									strong2.textContent = title;
									toastBody.appendChild(strong2);

									const bodyText = document.createElement('div');
									bodyText.style.margin = '10px 0px 10px 0px';
									bodyText.innerHTML = description;
									toastBody.appendChild(bodyText);

									const aTag = document.createElement('a');
									aTag.href = linkSlug;
									aTag.innerText = linkTitle;
									toastBody.appendChild(aTag);

									const showImage = document.createElement('img');
									showImage.style.margin = '10px 0px 0px 0px';
									showImage.src = linkImg;
									toastBody.appendChild(showImage);
									
									toast.appendChild(toastHeader);
									toast.appendChild(toastBody);
									toastContainer.appendChild(toast);
									
									const bootstrapToast = new bootstrap.Toast(toast);
									bootstrapToast.show();

									//createToast(toasts[num]);
								}
							});
						}, Math.random() * 2000 + 2000); // Random delay between 2000 and 4000 ms
					} else{console.log("No Toast Generated")}
				}

				// this will parse a CSV when loaded on a page
				function parseCSV(text) {
						const normalizedText = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
						const lines = normalizedText.split('\n');
						const result = [];
						let headers = lines[0].split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/).map(h => h.replace(/^"|"$/g, '').replace(/""/g, '"'));
						headers = headers.map(header => header.trim().toLowerCase().split(' ').map((word, index) => index === 0 ? word : word[0].toUpperCase() + word.slice(1)).join(''));
						for(let i = 1; i < lines.length; i++) {
							const obj = {};
							const currentLine = lines[i].split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/);
							for(let j = 0; j < headers.length; j++) {if (currentLine[j]) {let value = currentLine[j].replace(/^"|"$/g, '').replace(/""/g, '"'); obj[headers[j]] = value;}}
							result.push(obj);
						}
						return result; // Array of objects
					}

				// adds an ambulance if player is injured	
				function injuredPlayer(status){
					if(status == "injured"){injuryStatus = '<i class="fa-solid fa-truck-medical fa-fade" style="color: tomato; margin-left: 3px;"></i>';} else{injuryStatus = "";}
					return injuryStatus;
				}

    </script>
