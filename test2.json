<style type="text/css">
/* 
This was added 03_01_2026, as an update to WordPress messed around with layout of columns on my custom templates
This now relies on css grid for columns
stack-small-screen ensures layout for small screen
need to add other combinations of .cols-70-30 for example as and when needed
*/ 

.cols {
    display: grid;
    gap: 1rem;
    grid-template-columns: var(--cols);
    margin-bottom: 1rem;
}

.cols-25-75 {--cols: minmax(0, 25fr) minmax(0, 75fr);}
.cols-30-70 {--cols: minmax(0, 30fr) minmax(0, 70fr);}
.cols-50-50 {--cols: minmax(0, 1fr) minmax(0, 1fr);}
.cols-33-33-33 {--cols: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);}
.cols-25-25-25-25 {--cols: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);}
.cols-70-30 {--cols: minmax(0, 70fr) minmax(0, 30fr);}
.cols-20-60-20 {--cols: minmax(0, 20fr) minmax(0, 60fr) minmax(0, 20fr);}

@media (max-width: 768px) {
  .stack-small-screen {
    --cols: minmax(0, 1fr);
  }
  .hide-small-screen {
    display: none;
  }
}</style>
